{
  "name": "deepseek-kinetic-reel",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek kinetic-typography reel: canvas 2D type + three.js layers + WebGL post, rendered frame by frame in headless Chrome",
  "scripts": {
    "sheet": "node render.mjs --sheet=1,3.6,6.5,9,11.2,13.3,15.5,17.3 --cols=4 --w=480 --out=out/check/sheet.jpg",
    "frames": "node render.mjs --frames --workers=4",
    "score": "node music/score.mjs",
    "encode": "node render.mjs --encode --audio=assets/score.m4a --out=out/reel.mp4"
  },
  "dependencies": {
    "puppeteer-core": "^25.11.0",
    "three": "0.160.0"
  }
}
